    "We found your TrenteVingt budget on this iPhone: ^[%lld month](inflect: true) and ^[%lld transaction](inflect: true). Bring it into Trente to pick up where you left off." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har fundet dit TrenteVingt-budget på denne iPhone: %#@months@ og %#@transactions@. Hent det over i Trente, og fortsæt, hvor du slap."
          },
          "substitutions" : {
            "months" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg måned"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg måneder"
                    }
