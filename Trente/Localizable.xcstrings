    "Split your take-home income into Needs, Wants and Savings and Debts. Trente sorts every transaction into one of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile dein Nettoeinkommen in Bedürfnisse, Wünsche sowie Sparen & Schulden auf. Trente ordnet jede Transaktion einer davon zu."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split your take-home pay into Needs, Wants and Savings and Debts. Trente sorts every transaction into one of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparte tus ingresos netos entre Necesidades, Deseos y Ahorro y deudas. Trente clasifica cada transacción en una de ellas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparte tus ingresos netos entre Necesidades, Deseos y Ahorro y deudas. Trente clasifica cada transacción en una de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répartissez votre revenu net entre Besoins, Envies et Épargne et dettes. Trente classe chaque transaction dans l’une de ces catégories."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripartisci il tuo reddito netto tra Necessità, Desideri e Risparmi e debiti. Trente assegna ogni transazione a una di queste categorie."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실수령액을 필수, 선택, 저축 및 부채로 나누세요. Trente가 모든 거래를 그중 하나로 분류해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divida sua renda líquida entre Necessidades, Desejos e Poupança e dívidas. O Trente classifica cada transação em uma delas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divida o seu rendimento líquido entre Necessidades, Desejos e Poupança e dívidas. O Trente classifica cada transação numa delas."
          }
        }
      }
    },
