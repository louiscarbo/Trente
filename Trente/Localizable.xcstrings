        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ commence aujourd’hui"
          }
        }
      }
    },
    "%@ won't appear after today. Transactions already recorded stay." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’apparaîtra plus après aujourd’hui. Les transactions déjà enregistrées sont conservées."
          }
        }
      }
    },
