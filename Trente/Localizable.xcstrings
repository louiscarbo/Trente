    "On the due date, %@ is added to that month's transactions." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På forfaldsdagen føjes %@ til månedens transaktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Fälligkeitsdatum wird %@ zu den Transaktionen des Monats hinzugefügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Την ημέρα λήξης, το «%@» προστίθεται στις συναλλαγές εκείνου του μήνα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la fecha de vencimiento, %@ se añade a las transacciones de ese mes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la fecha de vencimiento, %@ se agrega a las transacciones de ese mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’échéance, %@ est ajouté aux transactions du mois."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’échéance, %@ est ajouté aux transactions du mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla scadenza, %@ viene aggiunto alle transazioni di quel mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期日になると、%@がその月の取引に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예정일이 되면 %@ 항목이 해당 달의 거래에 추가돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På forfallsdatoen legges %@ til i transaksjonene for den måneden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na data de vencimento, %@ é adicionado às transações do mês."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na data de vencimento, %@ é adicionado às transações desse mês."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det är dags läggs %@ till i den månadens transaktioner."
          }
        }
      }
    },
