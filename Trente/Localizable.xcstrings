          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou seus %lld registros gratuitos do Apple Pay este mês. Assine o Trente+ para registros automáticos ilimitados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
