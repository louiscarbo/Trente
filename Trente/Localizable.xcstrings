    "    You haven't started tracking your budget yet. Start tracking your budget with Trente by opening the app!" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Du er ikke begyndt at holde styr på dit budget endnu. Åbn Trente for at komme i gang!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Du hast noch nicht begonnen, dein Budget zu verfolgen. Öffne die Trente-App, um loszulegen!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Δεν έχετε ξεκινήσει ακόμα να παρακολουθείτε τον προϋπολογισμό σας. Ανοίξτε το Trente για να ξεκινήσετε!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Aún no has empezado a controlar tu presupuesto. ¡Abre la app Trente para empezar!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Aún no empezaste a controlar tu presupuesto. ¡Abre la app Trente para empezar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Vous n’avez pas encore commencé à suivre votre budget. Ouvrez l’app Trente pour commencer !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Vous n’avez pas encore commencé à suivre votre budget. Ouvrez l’app Trente pour commencer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Non hai ancora iniziato a monitorare il tuo budget. Apri l’app Trente per cominciare!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    まだ予算の記録がありません。Trenteを開いて始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    아직 예산 관리를 시작하지 않았어요. Trente 앱을 열고 시작해 보세요!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Du har ikke begynt å føre budsjett ennå. Åpne Trente for å komme i gang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Você ainda não começou a acompanhar seu orçamento. Abra o app Trente para começar!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Ainda não começou a acompanhar o seu orçamento. Abra a app Trente para começar!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Du har inte börjat följa din budget än. Öppna appen för att komma igång med Trente!"
          }
        }
      }
    },
