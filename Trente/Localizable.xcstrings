            "value" : "Dans l’onglet **Automatisation**, créez une automatisation avec le déclencheur **Cartes**, choisissez vos cartes et sélectionnez **Exécuter immédiatement**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
