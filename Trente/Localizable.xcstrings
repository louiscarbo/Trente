          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez appuyé longtemps sur le widget, puis touchez « Modifier le widget ». Vous pourrez alors changer la catégorie du widget."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez appuyé longtemps sur le widget, puis touchez « Modifier le widget ». Vous pourrez alors changer la catégorie du widget."
          }
