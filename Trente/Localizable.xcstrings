    "Get a reminder when a new month starts and when a recurring transaction is due, and a notification after each Apple Pay purchase." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en påmindelse, når en ny måned starter, og når en fast transaktion forfalder, og en notifikation efter hvert Apple Pay-køb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine Erinnerung, wenn ein neuer Monat beginnt und eine wiederkehrende Transaktion fällig ist, sowie eine Mitteilung nach jedem Apple Pay-Kauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβετε μια υπενθύμιση όταν ξεκινά νέος μήνας και όταν λήγει μια επαναλαμβανόμενη συναλλαγή, και μια γνωστοποίηση μετά από κάθε αγορά με Apple Pay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un recordatorio cuando empieza un nuevo mes y cuando vence una transacción recurrente, y una notificación tras cada compra con Apple Pay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un recordatorio cuando empieza un nuevo mes y cuando vence una transacción recurrente, y una notificación tras cada compra con Apple Pay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez un rappel quand un nouveau mois commence et quand une transaction récurrente arrive à échéance, et une notification après chaque achat Apple Pay."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez un rappel quand un nouveau mois commence et quand une transaction récurrente arrive à échéance, et une notification après chaque achat Apple Pay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un promemoria quando inizia un nuovo mese e quando scade una transazione ricorrente, e una notifica dopo ogni acquisto Apple Pay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい月の始まりと繰り返しの取引の期日にリマインダーが届きます。Apple Payで支払うたびに通知も届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 달이 시작될 때와 반복 거래 예정일에 알림을 받고, Apple Pay로 구매할 때마다 알림을 받으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en påminnelse når en ny måned starter og når en fast transaksjon forfaller, og en varsling etter hvert Apple Pay-kjøp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um lembrete quando um novo mês começar e quando uma transação recorrente vencer, e uma notificação após cada compra com Apple Pay."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um lembrete quando um novo mês começar e quando uma transação recorrente vencer, e uma notificação após cada compra Apple Pay."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en påminnelse när en ny månad börjar och när det är dags för en återkommande transaktion, och en notis efter varje Apple Pay-köp."
          }
        }
      }
    },
