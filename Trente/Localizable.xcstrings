    "Tap the **Transaction** field. In the bar above the keyboard, scroll to the end and tap **Transaction**." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på feltet **Transaktion**. Rul helt til enden af bjælken over tastaturet, og tryk på **Transaktion**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
