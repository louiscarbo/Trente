        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un promemoria quando inizia un nuovo mese e quando scade una transazione ricorrente, e una notifica dopo ogni acquisto Apple Pay."
          }
        }
      }
    },
