    "Add **Run Shortcut**, pick **Log Wallet Transaction** and pass it the **Shortcut Input**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge **Kurzbefehl ausführen** hinzu, wähle **Log Wallet Transaction** und übergib die **Kurzbefehl-Eingabe**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade **Ejecutar atajo**, elige **Log Wallet Transaction** y pásale la **Entrada del atajo**."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega **Ejecutar atajo**, elige **Log Wallet Transaction** y pásale la **Entrada del atajo**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez **Exécuter le raccourci**, choisissez **Log Wallet Transaction** et transmettez-lui l’**Entrée du raccourci**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi **Esegui comando rapido**, scegli **Log Wallet Transaction** e passagli l’**Input comando rapido**."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**단축어 실행**을 추가하고 **Log Wallet Transaction**을 선택한 다음 **단축어 입력**을 전달하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione **Executar Atalho**, escolha **Log Wallet Transaction** e passe a **Entrada do Atalho**."
          }
        },
        "pt-PT" : {
