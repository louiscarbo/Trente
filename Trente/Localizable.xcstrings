    "Trente only receives the merchant name and the amount. Never your card details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente erhält nur den Namen des Händlers und den Betrag. Niemals deine Kartendaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente solo recibe el nombre del comercio y el importe. Nunca los datos de tu tarjeta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente solo recibe el nombre del comercio y el importe. Nunca los datos de tu tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente reçoit uniquement le nom du commerçant et le montant. Jamais les informations de votre carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente riceve solo il nome dell’esercente e l’importo. Mai i dati della tua carta."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente는 가맹점 이름과 금액만 받아요. 카드 정보는 절대 받지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Trente recebe apenas o nome do estabelecimento e o valor. Nunca os dados do seu cartão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Trente recebe apenas o nome do comerciante e o montante. Nunca os dados do seu cartão."
          }
        }
      }
    },
    "Trente reminds you at this time when a new month starts and when a recurring transaction is due." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente erinnert dich zu dieser Uhrzeit, wenn ein neuer Monat beginnt und eine wiederkehrende Transaktion fällig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente te avisa a esta hora cuando empieza un nuevo mes y cuando vence una transacción recurrente."
