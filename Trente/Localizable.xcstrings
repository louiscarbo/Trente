    "" : {
      "shouldTranslate" : false
    },
    "    You haven't started tracking your budget yet. Start tracking your budget with Trente by opening the app!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Aún no has empezado a controlar tu presupuesto. ¡Abre la app Trente para empezar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Vous n’avez pas encore commencé à suivre votre budget. Ouvrez l’app Trente pour commencer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Non hai ancora iniziato a monitorare il tuo budget. Apri l’app Trente per cominciare!"
          }
        }
      }
    },
    "-" : {
      "shouldTranslate" : false
    },
