    "Paused without Trente+. Until you subscribe again, you'll be asked to confirm %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert ohne Trente+. Bis du wieder abonnierst, bestätigst du %@ selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa sin Trente+. Hasta que vuelvas a suscribirte, Trente te pedirá que confirmes %@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa sin Trente+. Hasta que vuelvas a suscribirte, Trente te pedirá que confirmes %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause sans Trente+. Jusqu’à votre prochain abonnement, Trente vous demandera de confirmer %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa senza Trente+. Finché non ti abboni di nuovo, Trente ti chiederà di confermare %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente+가 없어 일시 중지됐어요. 다시 구독할 때까지 %@ 항목은 직접 확인해야 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado sem o Trente+. Até você assinar de novo, o Trente vai pedir que você confirme %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa sem o Trente+. Até voltar a subscrever, o Trente pede-lhe que confirme %@."
          }
        }
      }
    },
