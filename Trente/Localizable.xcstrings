          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure o widget e depois toque em “Editar Widget”. Assim você pode mudar a categoria do widget."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o widget premido e depois toque em «Editar widget». Assim pode alterar a categoria do widget."
          }
        },
        "sv" : {
