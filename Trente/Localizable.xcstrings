    "You haven't opened Trente since %@, so reminders are paused. Open the app anytime to turn them back on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Trente seit dem %@ nicht geöffnet, deshalb sind die Erinnerungen pausiert. Öffne die App jederzeit, um sie wieder zu aktivieren."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't opened Trente since %@, so reminders are paused. Open the app at any time to turn them back on."
