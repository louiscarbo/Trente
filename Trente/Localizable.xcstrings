    "We found your data in iCloud: ^[%lld month](inflect: true) and ^[%lld transaction](inflect: true). It's all here, ready to pick up where you left off." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We found your data in iCloud: ^[%1$lld month](inflect: true) and ^[%2$lld transaction](inflect: true). It's all here, ready to pick up where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos encontrado tus datos en iCloud: %#@months@ y %#@transactions@. Todo está aquí, listo para continuar donde lo dejaste."
          },
          "substitutions" : {
            "months" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg mes"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg meses"
                    }
                  }
                }
              }
            },
            "transactions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg transacción"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg transacciones"
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons retrouvé vos données dans iCloud : %#@months@ et %#@transactions@. Tout est là, prêt pour reprendre là où vous en étiez."
          },
          "substitutions" : {
            "months" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg mois"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
