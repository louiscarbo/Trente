    "You haven't opened Trente on this iPad since %@, so reminders here are paused. Open the app anytime to turn them back on." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke åbnet Trente på denne iPad siden den %@, så påmindelserne her er sat på pause. Åbn appen når som helst for at slå dem til igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Trente auf diesem iPad seit dem %@ nicht geöffnet, deshalb sind die Erinnerungen hier pausiert. Öffne die App jederzeit, um sie wieder zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε ανοίξει το Trente σε αυτό το iPad από τις %@, γι’ αυτό οι υπενθυμίσεις εδώ είναι σε παύση. Ανοίξτε την εφαρμογή όποτε θέλετε για να τις ενεργοποιήσετε ξανά."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't opened Trente on this iPad since %@, so reminders here are paused. Open the app at any time to turn them back on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has abierto Trente en este iPad desde el %@, así que los recordatorios aquí están en pausa. Abre la app cuando quieras para reactivarlos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No abres Trente en este iPad desde el %@, así que los recordatorios aquí están en pausa. Abre la app cuando quieras para reactivarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas ouvert Trente sur cet iPad depuis le %@, les rappels sont donc en pause ici. Ouvrez l’app à tout moment pour les réactiver."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas ouvert Trente sur cet iPad depuis le %@, les rappels sont donc en pause ici. Ouvrez l’app à tout moment pour les réactiver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non apri Trente su questo iPad dal %@, quindi i promemoria qui sono in pausa. Apri l’app quando vuoi per riattivarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降このiPadでTrenteを開いていないため、このiPadのリマインダーを一時停止しています。アプリを開くと、いつでも再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이후 이 iPad에서 Trente를 열지 않아 이 기기의 리마인더가 일시 중지됐어요. 언제든지 앱을 열면 다시 켜져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke åpnet Trente på denne iPaden siden %@, så påminnelsene er satt på pause her. Åpne appen når som helst for å slå dem på igjen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não abre o Trente neste iPad desde %@, então os lembretes aqui estão pausados. Abra o app quando quiser para reativá-los."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não abre o Trente neste iPad desde %@, por isso os lembretes aqui estão em pausa. Abra a app quando quiser para os reativar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inte öppnat Trente på den här iPaden sedan den %@, så påminnelserna är pausade här. Öppna appen när som helst för att slå på dem igen."
          }
        }
      }
    },
