    "It won't be added in %@. Next years aren't affected. You can't undo this." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den bliver ikke tilføjet i %@. De kommende år berøres ikke. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird im Jahr %@ nicht hinzugefügt. Die folgenden Jahre sind nicht betroffen. Das kann nicht widerrufen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θα προστεθεί το %@. Τα επόμενα χρόνια δεν επηρεάζονται. Δεν μπορείτε να το αναιρέσετε."
          }
        },
        "es" : {
