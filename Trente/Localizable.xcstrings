    "In TrenteVingt, open Settings and tap Export for Trente. Save the file or send it to this device, then choose it here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn ”Settings” i TrenteVingt, og tryk på ”Export for Trente”. Gem filen, eller send den til denne enhed, og vælg den så her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne in TrenteVingt „Settings“ und tippe auf „Export for Trente“. Sichere die Datei oder sende sie an dieses Gerät und wähle sie dann hier aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο TrenteVingt, ανοίξτε τις Ρυθμίσεις και αγγίξτε «Εξαγωγή για το Trente». Αποθηκεύστε το αρχείο ή στείλτε το σε αυτή τη συσκευή και μετά επιλέξτε το εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En TrenteVingt, abre Ajustes y toca Exportar para Trente. Guarda el archivo o envíalo a este dispositivo y elígelo aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En TrenteVingt, abre Ajustes y toca Exportar para Trente. Guarda el archivo o envíalo a este dispositivo y elígelo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans TrenteVingt, ouvrez les Réglages et touchez Exporter pour Trente. Enregistrez le fichier ou envoyez-le sur cet appareil, puis choisissez-le ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans TrenteVingt, ouvrez les Réglages et touchez Exporter pour Trente. Enregistrez le fichier ou envoyez-le sur cet appareil, puis choisissez-le ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In TrenteVingt, apri «Settings» e tocca «Export for Trente». Salva il file o invialo a questo dispositivo, poi sceglilo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrenteVingtで「Settings」を開き、「Export for Trente」をタップします。ファイルを保存するか、このデバイスに送ってから、ここで選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrenteVingt에서 'Settings'를 열고 'Export for Trente'를 탭하세요. 파일을 저장하거나 이 기기로 보낸 다음 여기에서 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne «Settings» i TrenteVingt, og trykk på «Export for Trente». Lagre filen eller send den til denne enheten, og velg den så her."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No TrenteVingt, abra “Settings” e toque em “Export for Trente”. Salve o arquivo ou envie-o para este dispositivo e escolha-o aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No TrenteVingt, abra «Settings» e toque em «Export for Trente». Guarde o ficheiro ou envie-o para este dispositivo e escolha-o aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna ”Settings” i TrenteVingt och tryck på ”Export for Trente”. Spara filen eller skicka den till den här enheten och välj den sedan här."
          }
        }
      }
    },
