        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer votre mois"
          }
        }
      }
    },
    "We found your data in iCloud: ^[%lld month](inflect: true) and ^[%lld transaction](inflect: true). It's all here, ready to pick up where you left off." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We found your data in iCloud: ^[%1$lld month](inflect: true) and ^[%2$lld transaction](inflect: true). It's all here, ready to pick up where you left off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons retrouvé vos données dans iCloud : %#@months@ et %#@transactions@. Tout est là, prêt pour reprendre là où vous en étiez."
          },
          "substitutions" : {
            "months" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg mois"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg mois"
                    }
                  }
                }
              }
