    "%@ won't appear after today. Transactions already recorded stay." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vises ikke efter i dag. Transaktioner, der allerede er registreret, bliver liggende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erscheint ab morgen nicht mehr. Bereits erfasste Transaktionen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» δεν θα εμφανίζεται μετά τη σημερινή ημέρα. Οι συναλλαγές που έχουν ήδη καταγραφεί παραμένουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no aparecerá después de hoy. Las transacciones ya registradas se mantienen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no aparecerá después de hoy. Las transacciones ya registradas se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’apparaîtra plus après aujourd’hui. Les transactions déjà enregistrées sont conservées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’apparaîtra plus après aujourd’hui. Les transactions déjà enregistrées sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non apparirà più dopo oggi. Le transazioni già registrate restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は明日から表示されなくなります。記録済みの取引はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 이후로 %@ 항목이 더 이상 표시되지 않아요. 이미 기록된 거래는 그대로 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vises ikke etter i dag. Transaksjoner som allerede er registrert, blir liggende."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não vai mais aparecer depois de hoje. As transações já registradas permanecem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deixará de aparecer depois de hoje. As transações já registadas mantêm-se."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ visas inte efter idag. Redan loggade transaktioner finns kvar."
          }
        }
      }
    },
