    "When you add an income, choose how much goes to Needs, Wants and Savings and Debts. An expense always goes into a single category." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du tilføjer en indtægt, vælger du, hvor meget der går til Behov, Ønsker og Opsparing og gæld. En udgift hører altid til én kategori."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Einkommen hinzufügst, wählst du, wie viel in Bedürfnisse, Wünsche und Sparen & Schulden fließt. Eine Ausgabe gehört immer zu genau einer Kategorie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν προσθέτετε ένα έσοδο, επιλέγετε πόσα πάνε στις κατηγορίες Ανάγκες, Επιθυμίες και Αποταμίευση και χρέη. Ένα έξοδο πάει πάντα σε μία μόνο κατηγορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al añadir un ingreso, elige cuánto va a Necesidades, Deseos y Ahorro y deudas. Un gasto siempre va a una sola categoría."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agregar un ingreso, elige cuánto va a Necesidades, Deseos y Ahorro y deudas. Un gasto siempre va a una sola categoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous ajoutez un revenu, choisissez combien va dans Besoins, Envies et Épargne et dettes. Une dépense va toujours dans une seule catégorie."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous ajoutez un revenu, choisissez combien va dans Besoins, Envies et Épargne et dettes. Une dépense va toujours dans une seule catégorie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando aggiungi un’entrata, scegli quanto va in Necessità, Desideri e Risparmi e debiti. Una spesa va sempre in una sola categoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収入を追加するときに、「生活費」「ゆとり費」「貯蓄と返済」にいくらずつ入れるかを選びます。支出は必ず1つのカテゴリに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수입을 추가할 때 필수, 선택, 저축 및 부채에 각각 얼마를 넣을지 정하세요. 지출은 항상 한 카테고리에만 들어가요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du legger til en inntekt, velger du hvor mye som går til Behov, Ønsker og Sparing og gjeld. En utgift går alltid til én kategori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao adicionar uma renda, escolha quanto vai para Necessidades, Desejos e Poupança e dívidas. Uma despesa sempre vai para uma única categoria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao adicionar um rendimento, escolha quanto vai para Necessidades, Desejos e Poupança e dívidas. Uma despesa vai sempre para uma única categoria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du lägger till en inkomst väljer du hur mycket som går till Behov, Nöjen samt Sparande och skulder. En utgift hamnar alltid i en enda kategori."
          }
        }
      }
    },
