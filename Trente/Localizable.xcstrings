        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados não foram apagados. Experimente atualizar o Trente e partilhe os detalhes do erro se o problema persistir."
          }
        }
      }
    },
    "Your first month starts today. Log expenses as you go and Trente shows you what's left." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein erster Monat beginnt heute. Erfasse deine Ausgaben laufend und Trente zeigt dir, was übrig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primer mes empieza hoy. Registra tus gastos sobre la marcha y Trente te mostrará lo que te queda."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primer mes empieza hoy. Registra tus gastos sobre la marcha y Trente te mostrará lo que te queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre premier mois commence aujourd’hui. Enregistrez vos dépenses au fur et à mesure et Trente vous montre ce qu’il reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo primo mese inizia oggi. Registra le spese man mano e Trente ti mostra quanto ti resta."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 달이 오늘 시작돼요. 지출을 그때그때 기록하면 Trente가 남은 금액을 보여 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu primeiro mês começa hoje. Registre suas despesas no dia a dia e o Trente mostra quanto sobra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu primeiro mês começa hoje. Registe as despesas à medida que as faz e o Trente mostra-lhe quanto resta."
          }
        }
      }
    },
    "Your iCloud storage is full, so new changes stay on this device. Free up space in the Settings app to sync again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iCloud-Speicher ist voll, daher bleiben neue Änderungen auf diesem Gerät. Gib in der App „Einstellungen“ Speicherplatz frei, um wieder zu synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu almacenamiento de iCloud está lleno, así que los cambios nuevos se quedan en este dispositivo. Libera espacio en la app Ajustes para volver a sincronizar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu almacenamiento de iCloud está lleno, así que los cambios nuevos se quedan en este dispositivo. Libera espacio en la app Configuración para volver a sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre stockage iCloud est plein : les nouvelles modifications restent sur cet appareil. Libérez de l’espace dans l’app Réglages pour reprendre la synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo spazio iCloud è pieno, quindi le nuove modifiche restano su questo dispositivo. Libera spazio nell’app Impostazioni per sincronizzare di nuovo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 저장 공간이 가득 차서 새로운 변경 사항은 이 기기에만 저장돼요. 설정 앱에서 공간을 확보하면 다시 동기화돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu armazenamento do iCloud está cheio, então as novas alterações ficam neste dispositivo. Libere espaço no app Ajustes para sincronizar novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu armazenamento iCloud está cheio, por isso as novas alterações ficam neste dispositivo. Liberte espaço na app Definições para voltar a sincronizar."
