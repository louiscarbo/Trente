    "Paused without Trente+. Until you subscribe again, you'll be asked to confirm %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På pause uden Trente+. Indtil du abonnerer igen, skal du selv bekræfte %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert ohne Trente+. Bis du wieder abonnierst, bestätigst du %@ selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε παύση χωρίς το Trente+. Μέχρι να εγγραφείτε ξανά, το Trente θα σας ζητά να επιβεβαιώνετε τη συναλλαγή «%@»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa sin Trente+. Hasta que vuelvas a suscribirte, Trente te pedirá que confirmes %@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa sin Trente+. Hasta que vuelvas a suscribirte, Trente te pedirá que confirmes %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause sans Trente+. Jusqu’à votre prochain abonnement, Trente vous demandera de confirmer %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause sans Trente+. Jusqu’à votre prochain abonnement, Trente vous demandera de confirmer %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa senza Trente+. Finché non ti abboni di nuovo, Trente ti chiederà di confermare %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente+に登録していないため、一時停止しています。再度登録するまで、「%@」は毎回確認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente+가 없어 일시 중지됐어요. 다시 구독할 때까지 %@ 항목은 직접 확인해야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satt på pause uten Trente+. Frem til du abonnerer igjen, blir du bedt om å bekrefte %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado sem o Trente+. Até você assinar de novo, o Trente vai pedir que você confirme %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa sem o Trente+. Até voltar a subscrever, o Trente pede-lhe que confirme %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausad utan Trente+. Tills du har abonnemang igen får du bekräfta %@ själv."
          }
        }
      }
    },
