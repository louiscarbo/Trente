            "state" : "translated",
            "value" : "Trente %@"
          }
        }
      }
    },
    "Trente adds it for you on its due date, the next time you open the app. Your widgets count it right away." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente la añade por ti en su fecha de vencimiento, la próxima vez que abras la app. Tus widgets la tienen en cuenta al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente l’ajoute pour vous à son échéance, la prochaine fois que vous ouvrez l’app. Vos widgets la prennent en compte immédiatement."
          }
        }
      }
    },
    "Trente All Months" : {
