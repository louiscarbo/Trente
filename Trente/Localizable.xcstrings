          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente ti avvisa a quest’ora quando inizia un nuovo mese."
          }
        }
      }
    },
    "Trente reminds you at this time when a recurring transaction is due." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente te avisa a esta hora cuando vence una transacción recurrente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
