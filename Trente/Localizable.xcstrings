    "Transactions" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transactions"
          }
        }
      }
    },
    "Transactions that come back every week, month or year, like rent or a salary. Upcoming ones appear in the months you've created. Open one to mark it as Paid (or Received) or to skip just that one. A recurring transaction never changes past months." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des transactions qui reviennent chaque semaine, chaque mois ou chaque année, comme un loyer ou un salaire. Les prochaines apparaissent dans les mois que vous avez créés. Ouvrez-en une pour la marquer comme payée (ou reçue) ou pour ignorer uniquement celle-ci. Une transaction récurrente ne modifie jamais les mois passés."
          }
        }
      }
    },
    "Trente" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente"
          }
        }
      }
    },
    "Trente %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente %@"
          }
        }
      }
    },
    "Trente adds it for you on its due date, the next time you open the app. Your widgets count it right away." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente l’ajoute pour vous à son échéance, la prochaine fois que vous ouvrez l’app. Vos widgets la prennent en compte immédiatement."
          }
        }
      }
    },
    "Trente All Months" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente Tous les mois"
