    "Enter the income you expect this month, after taxes. A rough figure is fine." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv den indtægt, du forventer denne måned, efter skat. Et groft tal er helt fint."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib das Einkommen ein, das du diesen Monat erwartest, nach Steuern. Eine grobe Zahl reicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε το εισόδημα που περιμένετε αυτόν τον μήνα, μετά τους φόρους. Μια πρόχειρη τιμή αρκεί."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the income you expect this month, after tax. A rough figure is fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce los ingresos que esperas este mes, después de impuestos. Una cifra aproximada basta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa los ingresos que esperas este mes, después de impuestos. Una cifra aproximada basta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez le revenu que vous attendez ce mois-ci, après impôts. Un chiffre approximatif suffit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez le revenu que vous attendez ce mois-ci, après impôts. Un chiffre approximatif suffit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci le entrate che prevedi questo mese, al netto delle tasse. Una cifra approssimativa va bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月入ってくる見込みの収入を、税引き後で入力してください。おおよその金額で大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달에 들어올 것으로 예상되는 수입을 세금을 뗀 금액으로 입력하세요. 대략적인 금액이어도 괜찮아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppgi inntekten du forventer denne måneden, etter skatt. Et grovt anslag holder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe a renda que você espera neste mês, depois dos impostos. Um valor aproximado já serve."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique o rendimento que espera este mês, depois de impostos. Um valor aproximado chega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange den inkomst du förväntar dig den här månaden, efter skatt. En grov uppskattning räcker."
