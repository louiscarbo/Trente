    "Your data has not been deleted. Try updating Trente, and share the error details if the problem persists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten wurden nicht gelöscht. Versuche, Trente zu aktualisieren, und teile die Fehlerdetails, falls das Problem weiterhin besteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos no se han eliminado. Prueba a actualizar Trente y comparte los detalles del error si el problema continúa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos no se han eliminado. Intenta actualizar Trente y comparte los detalles del error si el problema continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données n’ont pas été supprimées. Essayez de mettre à jour Trente et partagez les détails de l’erreur si le problème persiste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati non sono stati eliminati. Prova ad aggiornare Trente e condividi i dettagli dell’errore se il problema persiste."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터는 삭제되지 않았어요. Trente를 업데이트해 보고, 문제가 계속되면 오류 세부 정보를 공유해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados não foram apagados. Tente atualizar o Trente e compartilhe os detalhes do erro se o problema continuar."
