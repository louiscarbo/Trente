    "These come from your Apple Pay automation in the Shortcuts app. To stop them, turn off or delete that automation." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kommer fra din Apple Pay-automatisering i appen Genveje. Vil du stoppe dem, skal du slå automatiseringen fra eller slette den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese kommen von deiner Apple Pay-Automation in der App „Kurzbefehle“. Um sie zu stoppen, deaktiviere oder lösche diese Automation."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προέρχονται από την αυτοματοποίηση Apple Pay στην εφαρμογή Συντομεύσεις. Για να τις σταματήσετε, απενεργοποιήστε ή διαγράψτε αυτή την αυτοματοποίηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provienen de tu automatización de Apple Pay en la app Atajos. Para detenerlas, desactiva o elimina esa automatización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provienen de tu automatización de Apple Pay en la app Atajos. Para detenerlas, desactiva o elimina esa automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles proviennent de votre automatisation Apple Pay dans l’app Raccourcis. Pour les arrêter, désactivez ou supprimez cette automatisation."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles proviennent de votre automatisation Apple Pay dans l’app Raccourcis. Pour les arrêter, désactivez ou supprimez cette automatisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivano dalla tua automazione Apple Pay nell’app Comandi Rapidi. Per interromperle, disattiva o elimina quell’automazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの通知は、「ショートカット」アプリのApple Payオートメーションから届きます。止めるには、そのオートメーションをオフにするか削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 알림은 단축어 앱의 Apple Pay 자동화에서 와요. 중단하려면 해당 자동화를 끄거나 삭제하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse kommer fra Apple Pay-automatiseringen din i Snarveier-appen. Hvis du vil stoppe dem, slår du av eller sletter den automatiseringen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elas vêm da sua automação do Apple Pay no app Atalhos. Para interrompê-las, desative ou apague essa automação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vêm da sua automatização Apple Pay na app Atalhos. Para as parar, desative ou apague essa automatização."
          }
        },
