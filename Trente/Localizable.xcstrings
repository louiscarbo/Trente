            "value" : "Trente è creato e mantenuto da una sola persona."
          }
        }
      }
    },
    "Trente is the successor of TrenteVingt (2023)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente es el sucesor de TrenteVingt (2023)."
          }
        },
