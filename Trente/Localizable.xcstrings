    "Touch and hold the widget, then tap “Edit Widget”. You can then change the widget's category." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold en finger på widgetten, og tryk derefter på ”Rediger widget”. Så kan du ændre widgettens kategori."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Finger auf das Widget und tippe dann auf „Widget bearbeiten“. Dort kannst du die Kategorie ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε παρατεταμένα το widget και μετά αγγίξτε «Επεξεργασία widget». Στη συνέχεια μπορείτε να αλλάξετε την κατηγορία του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el widget y toca «Editar widget». Así podrás cambiar la categoría del widget."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
