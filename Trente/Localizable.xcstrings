    "Add the Trente shortcut, then create one automation. Every card payment then shows up in Trente, ready to review." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el atajo de Trente y crea una automatización. Cada pago con tarjeta aparecerá en Trente, listo para revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le raccourci Trente, puis créez une automatisation. Chaque paiement par carte apparaît ensuite dans Trente, prêt à être vérifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il comando rapido di Trente, poi crea un’automazione. Ogni pagamento con carta apparirà in Trente, pronto da verificare."
          }
        }
      }
