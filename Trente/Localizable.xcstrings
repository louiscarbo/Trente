{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "    You haven't started tracking your budget yet. Start tracking your budget with Trente by opening the app!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Vous n’avez pas encore commencé à suivre votre budget. Ouvrez l’app Trente pour commencer !"
          }
        }
      }
    },
    "-" : {

    },
    "- %@ Remaining" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- %@ restants"
          }
        }
      }
    },
    "“Piggy Savings” by Vectors Market" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Piggy Savings » par Vectors Market"
          }
        }
      }
    },
    "“Remaining” is the income you logged this month minus what you spent. Your ideal budget is only a target. Add your paycheck as an income and your remaining amounts appear, overall and per category." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le « restant » correspond aux revenus enregistrés ce mois-ci, moins vos dépenses. Votre budget idéal n’est qu’un objectif. Ajoutez votre salaire comme revenu et vos montants restants apparaissent, au total et par catégorie."
          }
        }
      }
    },
    "%@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
