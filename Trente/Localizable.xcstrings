    "Add **Run Shortcut**, pick **Log Wallet Transaction** and pass it the **Shortcut Input**." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade **Ejecutar atajo**, elige **Log Wallet Transaction** y pásale la **Entrada del atajo**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez **Exécuter le raccourci**, choisissez **Log Wallet Transaction** et transmettez-lui l’**Entrée du raccourci**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi **Esegui comando rapido**, scegli **Log Wallet Transaction** e passagli l’**Input comando rapido**."
