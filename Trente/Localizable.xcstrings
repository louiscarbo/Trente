                      "state" : "translated",
                      "value" : "%arg transaction"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg transactions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "We start you on the 50/30/20 rule. Adjust it until it fits your life, you can change it every month." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
