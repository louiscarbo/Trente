    "Rent, salary, subscriptions: added on their due date, without a tap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miete, Gehalt, Abos: am Fälligkeitsdatum hinzugefügt, ganz ohne Tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alquiler, sueldo, suscripciones: se añaden en su fecha de vencimiento, sin tocar nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renta, sueldo, suscripciones: se agregan en su fecha de vencimiento, sin tocar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loyer, salaire, abonnements : ajoutés à leur échéance, sans que vous ayez à y penser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affitto, stipendio, abbonamenti: aggiunti alla scadenza, senza toccare nulla."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월세, 월급, 구독료가 예정일에 알아서 추가돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aluguel, salário, assinaturas: adicionados na data de vencimento, sem você tocar em nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renda, salário, subscrições: adicionados na data de vencimento, sem tocar em nada."
          }
        }
      }
    },
