    "Month Recap (remaining budget and spending) and Category Recap (what's left in one category; edit the widget to choose it). Both are also available on the Lock Screen on iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monatsübersicht (verbleibendes Budget und Ausgaben) und Kategorieübersicht (was in einer Kategorie übrig ist; bearbeite das Widget, um sie auszuwählen). Beide gibt es auf dem iPhone auch für den Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumen del mes (presupuesto restante y gastos) y Resumen por categoría (lo que queda en una categoría; edita el widget para elegirla). Ambos también están disponibles en la pantalla de bloqueo del iPhone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumen del mes (presupuesto restante y gastos) y Resumen por categoría (lo que queda en una categoría; edita el widget para elegirla). Ambos también están disponibles en la pantalla de bloqueo del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumé du mois (budget restant et dépenses) et Résumé par catégorie (ce qu’il reste dans une catégorie ; modifiez le widget pour la choisir). Les deux sont aussi disponibles sur l’écran verrouillé de l’iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riepilogo del mese (budget rimanente e spese) e Riepilogo categoria (quanto resta in una categoria; modifica il widget per sceglierla). Entrambi sono disponibili anche nella schermata di blocco di iPhone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 요약(남은 예산과 지출)과 카테고리 요약(한 카테고리에 남은 금액, 위젯을 편집해 카테고리 선택)이 있어요. 둘 다 iPhone 잠금 화면에서도 사용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumo do mês (orçamento restante e gastos) e Resumo da categoria (o que sobra em uma categoria; edite o widget para escolhê-la). Os dois também estão disponíveis na Tela Bloqueada do iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumo do mês (orçamento restante e gastos) e Resumo da categoria (o que resta numa categoria; edite o widget para a escolher). Ambos estão também disponíveis no ecrã bloqueado do iPhone."
          }
        }
      }
    },
