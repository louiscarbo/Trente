        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loyer, salaire, abonnements : ajoutés automatiquement, sans que vous ayez à y penser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affitto, stipendio, abbonamenti: aggiunti in automatico, senza doverci pensare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
