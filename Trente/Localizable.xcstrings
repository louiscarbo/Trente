    "Trente only receives the merchant name and the amount. Never your card details." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente modtager kun butikkens navn og beløbet. Aldrig dine kortoplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente erhält nur den Namen des Händlers und den Betrag. Niemals deine Kartendaten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Trente λαμβάνει μόνο το όνομα του εμπόρου και το ποσό. Ποτέ τα στοιχεία της κάρτας σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente solo recibe el nombre del comercio y el importe. Nunca los datos de tu tarjeta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente solo recibe el nombre del comercio y el importe. Nunca los datos de tu tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente reçoit uniquement le nom du commerçant et le montant. Jamais les informations de votre carte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente reçoit uniquement le nom du commerçant et le montant. Jamais les informations de votre carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente riceve solo il nome dell’esercente e l’importo. Mai i dati della tua carta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenteが受け取るのは店舗名と金額だけです。カード情報は受け取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente는 가맹점 이름과 금액만 받아요. 카드 정보는 절대 받지 않아요."
          }
        },
        "nb" : {
