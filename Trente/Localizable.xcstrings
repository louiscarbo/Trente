    "    You haven't started tracking your budget yet. Start tracking your budget with Trente by opening the app!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Du hast noch nicht begonnen, dein Budget zu verfolgen. Öffne die Trente-App, um loszulegen!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Aún no has empezado a controlar tu presupuesto. ¡Abre la app Trente para empezar!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Aún no empezaste a controlar tu presupuesto. ¡Abre la app Trente para empezar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Vous n’avez pas encore commencé à suivre votre budget. Ouvrez l’app Trente pour commencer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Non hai ancora iniziato a monitorare il tuo budget. Apri l’app Trente per cominciare!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    아직 예산 관리를 시작하지 않았어요. Trente 앱을 열고 시작해 보세요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "    Você ainda não começou a acompanhar seu orçamento. Abra o app Trente para começar!"
          }
