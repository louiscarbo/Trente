        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivano dalla tua automazione Apple Pay nell’app Comandi Rapidi. Per interromperle, disattiva o elimina quell’automazione."
          }
        }
      }
    },
    "Think of it as the money you're free to spend each month, once taxes are taken care of." : {
      "localizations" : {
