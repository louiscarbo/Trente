    "Rent, salary, subscriptions: added automatically, without you having to think about it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husleje, løn, abonnementer: tilføjes automatisk, uden at du skal tænke over det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miete, Gehalt, Abos: automatisch hinzugefügt, ohne dass du daran denken musst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενοίκιο, μισθός, συνδρομές: προστίθενται αυτόματα, χωρίς να χρειάζεται να το σκέφτεστε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alquiler, sueldo, suscripciones: se añaden solos, sin que tengas que pensar en ello."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renta, sueldo, suscripciones: se agregan solos, sin que tengas que pensar en ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loyer, salaire, abonnements : ajoutés automatiquement, sans que vous ayez à y penser."
