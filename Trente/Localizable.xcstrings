    "You've used your %lld free Apple Pay logs this month. Get Trente+ for unlimited automatic logging." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brugt dine %lld gratis Apple Pay-registreringer denne måned. Med Trente+ er den automatiske registrering ubegrænset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine %lld kostenlosen Apple Pay-Erfassungen für diesen Monat aufgebraucht. Mit Trente+ erfasst du alle Zahlungen automatisch und unbegrenzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήσατε και τις %lld δωρεάν καταγραφές Apple Pay αυτού του μήνα. Αποκτήστε το Trente+ για απεριόριστη αυτόματη καταγραφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has usado tus %lld registros gratuitos de Apple Pay de este mes. Consigue Trente+ para registrar sin límites y de forma automática."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaste tus %lld registros gratuitos de Apple Pay de este mes. Obtén Trente+ para registrar sin límites y de forma automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez utilisé vos %lld connexions à Apple Pay ce mois-ci. Passez à Trente+ pour des enregistrements automatiques illimités."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez utilisé vos %lld connexions à Apple Pay ce mois-ci. Passez à Trente+ pour des enregistrements automatiques illimités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai usato le %lld registrazioni Apple Pay gratuite di questo mese. Passa a Trente+ per registrazioni automatiche illimitate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月の無料のApple Pay記録%lld件を使い切りました。Trente+なら、件数の制限なく自動で記録できます。"
